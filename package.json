{
  "name": "bg-ecosystem",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run check:release-preflight && npm --prefix frontend ci && npm --prefix frontend run build:cloudflare",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "check:deploy": "wrangler deploy --dry-run",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "npm --prefix frontend run typecheck",
    "cf-typegen": "wrangler types --config frontend/wrangler.jsonc --env-interface CloudflareEnv --include-runtime=false worker-configuration.d.ts",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "check:release-preflight": "node scripts/check-release-preflight.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2",
    "wrangler": "4.153.0"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "type": "module"
}
