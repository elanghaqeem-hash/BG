{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bg",
  "main": "../cloudflare/worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "BG_BANK",
        "class_name": "BankBackend"
      }
    ]
  },
  "migrations": [
    {
      "tag": "bg-native-v1",
      "new_sqlite_classes": [
        "BankBackend"
      ]
    }
  ],
  "vars": {
    "BG_MODE": "SANDBOX"
  },
  "secrets": {
    "required": [
      "BG_INITIAL_USERS",
      "BG_ENCRYPTION_KEY"
    ]
  }
}
