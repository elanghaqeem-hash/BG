  "components": {
    "schemas": {
      "ApplicationIn": {
        "properties": {
          "principal": {
            "type": "string",
            "title": "Principal"
          },
          "obligee": {
            "type": "string",
            "title": "Obligee"
          },
          "partner": {
            "type": "string",
            "title": "Partner"
          },
          "processing_office": {
            "type": "string",
            "title": "Processing Office"
          },
          "issuing_office": {
            "type": "string",
            "title": "Issuing Office"
          },
          "project_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Project Name"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "issue_on": {
            "type": "string",
            "title": "Issue On"
          },
          "expires_on": {
            "type": "string",
            "title": "Expires On"
          },
          "bg_type": {
            "type": "string",
            "title": "Bg Type",
            "default": "PELAKSANAAN"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "IDR"
          },
          "custom_format": {
            "type": "boolean",
            "title": "Custom Format",
            "default": false
          },
          "mandate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mandate"
          },
          "product": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product"
          },
          "justification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Justification"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "principal",
          "obligee",
          "partner",
          "processing_office",
          "issuing_office",
          "project_name",
          "amount",
          "issue_on",
          "expires_on"
        ],
        "title": "ApplicationIn"
      },
      "ClaimIn": {
        "properties": {
          "document": {
            "type": "string",
            "title": "Document"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document",
          "amount"
        ],
        "title": "ClaimIn"
      },
      "Command": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 120,
            "minLength": 8,
            "title": "Idempotency Key"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "idempotency_key"
        ],
        "title": "Command"
      },
      "DocumentIn": {
        "properties": {
          "kind": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Kind"
          },
          "content_base64": {
            "type": "string",
            "maxLength": 2800000,
            "title": "Content Base64"
          },
          "source_reference": {
            "type": "string",
            "maxLength": 500,
            "title": "Source Reference",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "content_base64"
        ],
        "title": "DocumentIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "MandateIn": {
        "properties": {
          "principal": {
            "type": "string",
            "title": "Principal"
          },
          "broker": {
            "type": "string",
            "title": "Broker"
          },
          "document": {
            "type": "string",
            "title": "Document"
          },
          "application_id": {
            "type": "string",
            "title": "Application Id"
          },
          "expires": {
            "type": "string",
            "title": "Expires"
          },
          "commission_disclosed": {
            "type": "boolean",
            "title": "Commission Disclosed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "principal",
          "broker",
