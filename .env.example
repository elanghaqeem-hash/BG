# Backend Compose configuration. Generate unique values; never commit real secrets.
BG_DB_PASSWORD=
BG_ENCRYPTION_KEY=

# Cloudflare runtime variable (set through Workers Settings > Variables and Secrets).
# Supply the HTTPS origin of the separately hosted FastAPI sandbox, with no /api suffix.
BG_API_INTERNAL_URL=
# Do not enable BG_ALLOW_LOCAL_API in a published Worker.
